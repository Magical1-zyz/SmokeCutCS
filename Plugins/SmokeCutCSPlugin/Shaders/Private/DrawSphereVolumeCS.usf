#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

RWTexture3D<float4> OutputTexture;

float3 CenterUVW;
float Radius;
float EdgeSoftness;
float Strength;
int3 TextureSize;

[numthreads(4, 4, 4)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= TextureSize.x ||
		DispatchThreadId.y >= TextureSize.y ||
		DispatchThreadId.z >= TextureSize.z)
	{
		return;
	}

	float3 uvw = (float3(DispatchThreadId.xyz) + 0.5) / float3(TextureSize);

	float dist = distance(uvw, CenterUVW);

	float innerRadius = max(Radius - EdgeSoftness, 0.0);
	float sphereMask = 1.0 - smoothstep(innerRadius, Radius, dist);

	float value = saturate(sphereMask * Strength);

	float4 oldValue = OutputTexture[DispatchThreadId.xyz];

	float finalValue = max(oldValue.r, value);

	OutputTexture[DispatchThreadId.xyz] = float4(finalValue, finalValue, finalValue, 1.0);
}